# OpenClaw stack .env — fill every CHANGE_ME. Keep this file at mode 600. Never commit it.

## Host
TZ=UTC                                  # e.g. America/Denver
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest   # use ghcr.io/openclaw/openclaw:latest-browser for web browsing
OPENCLAW_GATEWAY_HOST_PORT=18789        # change only if 18789 is taken on the host

## Gateway auth (generated at assembly, not a secret you must fetch; you paste it into the control UI once)
OPENCLAW_GATEWAY_TOKEN=GENERATED_AT_ASSEMBLY
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=
OPENCLAW_DISABLE_BONJOUR=

## LLM provider — keep the block(s) for providers in answers.md, delete the rest
# --- anthropic ---
ANTHROPIC_API_KEY=CHANGE_ME             # https://console.anthropic.com/settings/keys
# --- openai ---
OPENAI_API_KEY=CHANGE_ME                # https://platform.openai.com/api-keys
# --- openrouter ---
OPENROUTER_API_KEY=CHANGE_ME            # https://openrouter.ai/settings/keys

## Channels — keep the block(s) for channels in answers.md, delete the rest
# --- telegram ---
TELEGRAM_BOT_TOKEN=CHANGE_ME            # Telegram: message @BotFather, /newbot, copy the token
# --- discord ---
DISCORD_TOKEN=CHANGE_ME                 # https://discord.com/developers/applications → Bot → Reset Token
