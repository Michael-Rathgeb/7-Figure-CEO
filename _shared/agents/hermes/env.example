# Hermes stack .env — fill every CHANGE_ME. Keep this file at mode 600. Never commit it.

## Host
TZ=UTC                                  # e.g. America/Denver
HERMES_DASHBOARD_HOST_PORT=9119         # change only if 9119 is taken on the host
HERMES_API_HOST_PORT=8642
HERMES_UID=1000                         # `id -u` of the user that owns the stack folder on the host
HERMES_GID=1000                         # `id -g` of that user

## Dashboard login (generated at assembly, not a secret you must fetch)
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=GENERATED_AT_ASSEMBLY

## OpenAI-compatible API server (off by default)
HERMES_API_ENABLED=false
HERMES_API_KEY=GENERATED_AT_ASSEMBLY    # only used when HERMES_API_ENABLED=true

## LLM provider — keep the block(s) for providers in answers.md, delete the rest
# --- chatgpt-subscription (openai-codex) ---
# No key. Log in once with a device code during bootstrap; credentials land in ./data/auth.json.
# --- anthropic ---
ANTHROPIC_API_KEY=CHANGE_ME             # https://console.anthropic.com/settings/keys
# --- openai ---
OPENAI_API_KEY=CHANGE_ME                # https://platform.openai.com/api-keys
# --- openrouter ---
OPENROUTER_API_KEY=CHANGE_ME            # https://openrouter.ai/settings/keys

## Channels — keep the block(s) for channels in answers.md, delete the rest
# --- telegram ---
TELEGRAM_BOT_TOKEN=CHANGE_ME            # Telegram: message @BotFather, /newbot, copy the token
TELEGRAM_ALLOWED_USERS=CHANGE_ME        # your numeric id: message @userinfobot. Comma-separate for several people
# --- discord ---
DISCORD_BOT_TOKEN=CHANGE_ME             # https://discord.com/developers/applications → Bot → Reset Token
